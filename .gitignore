__pycache__/
*.pyc
.venv/
.pytest_cache/

# The Synthea archive and the unpacked bundles. 95 MB and 1.2 GB. The panel
# built from them is vendored instead, with the archive's sha256 recorded in
# data/vendor/panel_provenance.json.
data/raw/
data/work/

# Run output is ignored by default, then the parts a reader needs are added
# back. Each level has to be un-ignored explicitly: git will not look inside an
# excluded directory to find a negated pattern, so `!runs/tierA/cassettes/`
# alone would match nothing.
runs/*
!runs/tierA/
runs/tierA/*
!runs/tierA/cassettes/
# Two agents record into their own store, and the negations here listed only the
# main one, so 33 counterfactual and 14 critic-probe cassettes were never
# tracked. `run.py reproduce` runs the counterfactual step in record mode, so on
# a fresh clone that step had no cassettes to replay and tried to call a model,
# against a README that promises the whole pipeline runs offline with no key.
!runs/tierA/cassettes_counterfactual/
!runs/tierA/cassettes_critic_probe/
!runs/tierA/trajectories/
!runs/tierA/compiled/
!runs/tierA/signoffs.jsonl
!runs/tierA/manifest.json

# Checker B, the blind second labeller, ships too. The blindness claim is not
# "the labels were committed early", it is "here is every prompt B was sent, go
# and read them", and a reader who clones without the cassettes cannot check it.
# `scripts/verify.py blind` reported PASS having scanned nothing for anyone but
# me until these were tracked, which is the same silent-empty failure the check
# itself now refuses to commit.
!runs/checker_b/
runs/checker_b/*
!runs/checker_b/cassettes/
!runs/checker_b/trajectories/

# The grounding probes. `README.md`'s hot take rests entirely on the weak-model
# run, 14 of 21 against 20 of 21, and the rule that produced those numbers is
# the vocabulary probe's before and after. All three were excluded by `runs/*`,
# so a judge cloning this repository got the conclusion and none of the record:
# the probe agent had zero trajectories and zero cassettes in a clone. A claim
# whose evidence is not in the submission is a claim, not a result.
!runs/probe-weak/
runs/probe-weak/*
!runs/probe-weak/cassettes/
!runs/probe-weak/trajectories/
!runs/probe-before/
runs/probe-before/*
!runs/probe-before/cassettes/
!runs/probe-before/trajectories/
!runs/probe-after/
runs/probe-after/*
!runs/probe-after/cassettes/
!runs/probe-after/trajectories/

# Cells are one row per patient-criterion pair. Replay regenerates them from the
# cassettes in seconds, and shipping several hundred thousand rows would bury
# the things worth reading.
runs/tierA/cells/

# Directories created by tooling that resolved a broken path variable while
# running inside this tree. A CLI launched with a partially expanded
# %SystemDrive% or a redirected package cache writes here rather than failing,
# and `git add -A` will happily commit 167 MB of somebody else's Python.
/Python/
/%SystemDrive%/
/dev-cachenpm-cache/
/trace-runs/
/.code-review-graph/
/AppData/
local_dev.db
profile-claim.lock

# Video build intermediates. Regenerable offline from what is tracked:
# `python scripts/make_video.py shots` recaptures, `assemble` re-renders.
docs/video/frames/
docs/video/shots/
# The rendered file itself is tens of megabytes and is hosted, not committed.
# The link is in docs/VIDEO.md. What is tracked is everything needed to rebuild
# it: the script, the narration audio, its cue timings, and the shot spec.
docs/video/*.mp4

# Internal planning and the internal review passes. These carry internal
# notes and working notes, which is
# working material and not a deliverable. SUBMISSION.md requires none of it, and
# the pre-registration a reader needs is in docs/EVAL_PROTOCOL.md.
plan/
